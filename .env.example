# PoyoVault — Supabase configuration
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# PoyoVault runs in demo mode (local sample data) while these are empty.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used exclusively by `npm run seed`; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
